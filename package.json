{
  "name": "backed",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "node scripts/ensure-npm-publish-auth.mjs && pnpm build && changeset publish",
    "cli": "node apps/cli/dist/cli.js",
    "smoke:semantic-nl": "node scripts/semantic-nl-smoke.mjs",
    "report:semantic-ask": "node scripts/semantic-ask-report.mjs",
    "generate:schema": "pnpm --filter @trybacked/core run generate:schema",
    "deploy:check": "node deploy/scripts/check-stack.mjs",
    "deploy:smoke": "bash deploy/scripts/smoke-stack.sh",
    "check:ci": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm generate:schema && pnpm --filter @trybacked/api-server generate:openapi && git diff --exit-code schema/anchor-schema-v1.json apps/api-server/openapi.json && pnpm guardrails && pnpm test:coverage",
    "guardrails": "node scripts/no-domain-literals.mjs && depcruise --validate .dependency-cruiser.cjs packages apps"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.19.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.5",
    "dependency-cruiser": "^16.10.0"
  }
}
