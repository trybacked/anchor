{
  "name": "backed",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "pnpm build && changeset publish",
    "cli": "node apps/cli/dist/cli.js",
    "auth-api": "node apps/auth-api/dist/index.js",
    "compare:ontology": "pnpm --filter @backed/semantic run compare:ontology",
    "compare:ontology:complex": "pnpm --filter @backed/semantic run compare:ontology:complex",
    "generate:schema": "pnpm --filter @trybacked/core run generate:schema"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.19.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.5"
  }
}
