# Variabili non-segrete per servizio Railway (progetto backed).
# I segreti vanno in railway.secrets.env.example

# --- Gateway (servizio pubblico, es. api.backed.app) ---
HOST=0.0.0.0
NODE_ENV=production
GATEWAY_AUTH_MODE=workos
GATEWAY_COOKIE_SECURE=1
BACKED_REGISTRY_SOURCE=http
BACKED_REGISTRY_URL=http://control-plane.railway.internal:8791/v1/registry
BACKED_CONTROL_PLANE_URL=http://control-plane.railway.internal:8791
GATEWAY_PLATFORM_UPSTREAM=http://platform-api.railway.internal:8787

# --- Platform-api (solo rete privata) ---
HOST=0.0.0.0
ANCHOR_AUDIT_LOG_STDERR=1
BACKED_REGISTRY_SOURCE=http
BACKED_REGISTRY_URL=http://control-plane.railway.internal:8791/v1/registry

# --- Control-plane ---
HOST=0.0.0.0
CONTROL_PLANE_PORT=8791
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Provisioner (stesse env del control-plane, start: node dist/worker.js) ---
