# Non-secret variables per Railway service (backed project).
# Secrets go in railway.secrets.env.example

# --- Gateway (public service, e.g. api.backed.app) ---
HOST=0.0.0.0
NODE_ENV=production
GATEWAY_AUTH_MODE=workos
GATEWAY_COOKIE_SECURE=1
BACKED_REGISTRY_SOURCE=http
# Railway injects PORT=8080; private DNS uses the service privateNetworkEndpoint (e.g. control-plane, platform-api).
BACKED_REGISTRY_URL=http://control-plane.railway.internal:8080/v1/registry
BACKED_CONTROL_PLANE_URL=http://control-plane.railway.internal:8080
GATEWAY_PLATFORM_UPSTREAM=http://platform-api.railway.internal:8080

# --- Platform-api (private network only) ---
HOST=0.0.0.0
ANCHOR_AUDIT_LOG_STDERR=1
BACKED_REGISTRY_SOURCE=http
BACKED_REGISTRY_URL=http://control-plane.railway.internal:8791/v1/registry
BACKED_ENGINE=files
BACKED_S3_BUCKET=backed-v1
BACKED_S3_REGION=eu-north-1
BACKED_ONTOLOGY_REGISTRY_STORAGE=s3
BACKED_ONTOLOGY_REGISTRY_S3_PREFIX=_ontology-registry

# --- Control-plane ---
HOST=0.0.0.0
CONTROL_PLANE_PORT=8791
# Optional Levanto Sage: set SAGE_API_KEY to enable; omit for legacy confidence-only policy
# ANCHOR_DECISION_ACCEPT_THRESHOLD=0.9
# ANCHOR_DECISION_REJECT_THRESHOLD=0.8
# ANCHOR_SERVER_AUTO_APPROVE_THRESHOLD_MIN=0.85
# SAGE_API_KEY= (secret, control-plane only)
# SAGE_BASE_URL=https://sage.levanto.ai
# SAGE_TIMEOUT_MS=15000
# SAGE_REASONING=auto
DATABASE_URL=${{Postgres.DATABASE_URL}}
BACKED_ENGINE=files
BACKED_S3_BUCKET=backed-v1
BACKED_S3_REGION=eu-north-1
BACKED_ONTOLOGY_REGISTRY_STORAGE=s3
BACKED_ONTOLOGY_REGISTRY_S3_PREFIX=_ontology-registry

# --- Provisioner (same env as control-plane, start: node dist/worker.js) ---
