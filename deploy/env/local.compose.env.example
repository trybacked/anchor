# Copy to anchor/deploy/.env (gitignored)
# Profile: file registry + users.yaml auth

GATEWAY_SESSION_SECRET=replace-with-openssl-rand-hex-32
GATEWAY_PUBLIC_PORT=8080
GATEWAY_COOKIE_SECURE=0
GATEWAY_AUTH_MODE=file
BACKED_REGISTRY_SOURCE=file

GATEWAY_PLATFORM_TOKEN=replace-with-openssl-rand-hex-24
ANCHOR_API_TOKEN=replace-with-same-value-as-GATEWAY_PLATFORM_TOKEN

BACKED_DATABRICKS_HOST=your-workspace.cloud.databricks.com
BACKED_DATABRICKS_TOKEN=dapi***
BACKED_DATABRICKS_WAREHOUSE_ID=warehouse-id

# Optional — semantic ask
AI_GATEWAY_API_KEY=

# --- Only when BACKED_REGISTRY_SOURCE=http ---
