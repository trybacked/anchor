# Segreti da impostare in Railway (shared o per servizio).
# Non committare valori reali. Databricks: output di `backed platform bootstrap`.

# === Condivisi (platform-api + control-plane + provisioner) ===
BACKED_DATABRICKS_HOST=
BACKED_DATABRICKS_TOKEN=
BACKED_DATABRICKS_WAREHOUSE_ID=
BACKED_PLATFORM_PRINCIPAL=

# === Token piattaforma (platform-api + gateway) ===
ANCHOR_API_TOKEN=
GATEWAY_PLATFORM_TOKEN=

# === Control plane ===
CONTROL_PLANE_ADMIN_TOKEN=
CONTROL_PLANE_INTERNAL_TOKEN=

# === Gateway ===
GATEWAY_SESSION_SECRET=

# === WorkOS (solo gateway) — riusa progetto WorkOS esistente ===
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=https://api.backed.app/callback
