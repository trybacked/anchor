# Secrets to set in Railway (shared or per service).
# Do not commit real values.

# === Shared (platform-api + control-plane + provisioner) ===
BACKED_ENGINE=files
BACKED_S3_BUCKET=backed-v1
BACKED_S3_REGION=eu-north-1
BACKED_PLATFORM_PRINCIPAL=

# === Platform tokens (platform-api + gateway) ===
ANCHOR_API_TOKEN=
GATEWAY_PLATFORM_TOKEN=

# === Control plane ===
CONTROL_PLANE_ADMIN_TOKEN=
CONTROL_PLANE_INTERNAL_TOKEN=

# === Gateway ===
GATEWAY_SESSION_SECRET=

# === WorkOS (gateway only) — reuse existing WorkOS project ===
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=https://api.backed.app/callback
