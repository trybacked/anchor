{
  "name": "@trybacked/infrastructure",
  "version": "0.2.0",
  "type": "module",
  "description": "Composition root: maps tenant profiles onto registered adapters (ports -> adapters).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybacked/anchor.git",
    "directory": "packages/infrastructure"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@trybacked/compiler": "workspace:*",
    "@trybacked/core": "workspace:*",
    "@trybacked/ports": "workspace:*",
    "@trybacked/registry": "workspace:*",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^3.0.5"
  }
}
