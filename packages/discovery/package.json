{
  "name": "@trybacked/discovery",
  "version": "0.2.1",
  "type": "module",
  "description": "Deterministic ontology discovery from dataset inspection (profile / schema analysis)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybacked/anchor.git",
    "directory": "packages/discovery"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@trybacked/core": "workspace:*"
  }
}
