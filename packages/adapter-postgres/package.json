{
  "name": "@trybacked/adapter-postgres",
  "version": "0.1.0",
  "type": "module",
  "description": "Postgres warehouse adapter for Anchor (DatasetProvider + SQL executor + registry).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@trybacked/core": "workspace:*",
    "@trybacked/ports": "workspace:*",
    "@trybacked/registry": "workspace:*",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "@trybacked/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^3.0.5"
  }
}