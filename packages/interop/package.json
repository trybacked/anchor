{
  "name": "@trybacked/interop",
  "version": "0.1.0",
  "type": "module",
  "description": "RDF/Turtle export for Anchor ontologies",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
