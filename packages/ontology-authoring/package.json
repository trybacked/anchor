{
  "name": "@trybacked/ontology-authoring",
  "version": "0.1.0",
  "type": "module",
  "description": "Ontology draft commands, validation, diff, and packs",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@trybacked/compiler": "workspace:*",
    "@trybacked/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
