{
  "name": "@trybacked/capability-tabular",
  "version": "0.1.1",
  "type": "module",
  "description": "Tabular capability: structured sources (ERP, CSV, external DBs) as plain datasets.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@trybacked/capability-documents": "workspace:^",
    "@trybacked/core": "workspace:*"
  }
}
