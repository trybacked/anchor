{
  "name": "@trybacked/ontology-extract",
  "version": "0.1.0",
  "type": "module",
  "description": "LLM-assisted ontology extraction from docs warehouse profiles and file samples",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybacked/anchor.git",
    "directory": "packages/ontology-extract"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4",
    "@trybacked/core": "workspace:*",
    "@trybacked/discovery": "workspace:*",
    "ai": "^7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@trybacked/adapter-databricks": "workspace:*",
    "vitest": "^3.0.5"
  }
}
