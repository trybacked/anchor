{
  "name": "@backed/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "model.yaml schema, shared types, run artifacts (.backed/)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "generate:schema": "node scripts/generate-json-schema.mjs"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.24.0"
  }
}
