{
  "name": "@trybacked/anchor",
  "version": "0.3.0",
  "type": "module",
  "description": "HTTP client for the Anchor API (generated from OpenAPI)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybacked/anchor.git",
    "directory": "packages/anchor"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@trybacked/service": "workspace:*"
  }
}
