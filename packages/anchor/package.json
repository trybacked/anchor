{
  "name": "@trybacked/anchor",
  "version": "0.1.4",
  "type": "module",
  "description": "Official TypeScript SDK for the Anchor worker HTTP API",
  "sideEffects": false,
  "keywords": [
    "anchor",
    "backed",
    "sdk",
    "typescript",
    "semantic-model",
    "pipeline",
    "webhook"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybacked/anchor.git",
    "directory": "packages/anchor"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook/index.d.ts",
      "default": "./dist/webhook/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:openapi": "openapi-typescript ../../apps/worker-service/openapi.yaml -o src/generated/openapi.d.ts",
    "build": "pnpm generate:openapi && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate:openapi && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@trybacked/core": "^0.1.0",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
