# Required — listen on all interfaces in containers
WORKER_SERVICE_HOST=0.0.0.0
# Defaults to 127.0.0.1:8790 locally. Hosts that inject PORT (Railway, Fly) win over this.
WORKER_SERVICE_PORT=8790

# Required — mount a persistent volume here in production
WORKER_SERVICE_DATA_ROOT=/data

# Auth — pick exactly one path. Startup fails if neither is configured.
# A) Control plane (production): partner tokens live in Postgres.
#    Both vars are required together.
CONTROL_PLANE_URL=https://control-plane.example.com
WORKER_INTERNAL_SECRET=

# B) Local dev fallback: static token and/or inline partner registry.
# WORKER_SERVICE_AUTH_TOKEN=dev
# WORKER_SERVICE_PARTNERS_JSON=[{"partnerId":"partner-a","token":"REPLACE_ME","tenantIdPattern":"^partner-a-","webhookSecret":"REPLACE_ME","webhooks":{"runCompleted":"https://partner.example.com/hooks/run-completed"}}]

# Required for LLM inference (semantic proposal stage)
AI_GATEWAY_API_KEY=

# Optional limits — values shown are the built-in defaults
# WORKER_SERVICE_MAX_UPLOAD_BYTES=209715200
# WORKER_SERVICE_MAX_UPLOAD_FILES=500
# WORKER_SERVICE_RATE_LIMIT_WINDOW_MS=60000
# WORKER_SERVICE_RATE_LIMIT_MAX_REQUESTS=120
# Chunk embeddings are skipped by default; set to false to enable semantic search.
# WORKER_SERVICE_SKIP_EMBED=true
