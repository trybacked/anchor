# Required — listen on all interfaces in containers
WORKER_SERVICE_HOST=0.0.0.0
WORKER_SERVICE_PORT=8790

# Required — mount a persistent volume here in production
WORKER_SERVICE_DATA_ROOT=/data

# Auth (pick one path):
# A) Control plane (production) — partner tokens live in Postgres
CONTROL_PLANE_URL=https://cloud-production-2e92.up.railway.app
WORKER_INTERNAL_SECRET=

# B) Local dev fallback
# WORKER_SERVICE_AUTH_TOKEN=dev
# WORKER_SERVICE_PARTNERS_JSON=[{"partnerId":"partner-a","token":"...","tenantIdPattern":"^partner-a-","webhookSecret":"...","webhooks":{"runCompleted":"https://..."}}]

# Required for LLM inference (semantic proposal stage)
AI_GATEWAY_API_KEY=

# Optional limits
# WORKER_SERVICE_MAX_UPLOAD_BYTES=209715200
# WORKER_SERVICE_MAX_UPLOAD_FILES=500
# WORKER_SERVICE_RATE_LIMIT_WINDOW_MS=60000
# WORKER_SERVICE_RATE_LIMIT_MAX_REQUESTS=120
# WORKER_SERVICE_SKIP_EMBED=true
