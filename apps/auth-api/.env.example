# Device-flow auth API backing `backed login`.
# Binds to 127.0.0.1:8787 (see src/constants.ts); state is in-memory and resets on restart.
# Point the CLI at it with BACKED_API_URL=http://127.0.0.1:8787

# Identity returned to every approved device in dev mode.
# BACKED_AUTH_DEV_USER_ID=dev-user
# BACKED_AUTH_DEV_USER_EMAIL=dev@backed.local
# BACKED_AUTH_DEV_USER_NAME=Dev User
