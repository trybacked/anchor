{
  "name": "@backed/auth-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Backed auth API for CLI device login (local dev / reference)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@backed/http-kernel": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
