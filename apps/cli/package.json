{
  "name": "@trybacked/cli",
  "version": "0.2.1",
  "type": "module",
  "description": "Anchor CLI (`backed`): pull, sync, and deploy a governed ontology over Databricks",
  "license": "Apache-2.0",
  "keywords": [
    "anchor",
    "backed",
    "ontology",
    "databricks",
    "mcp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybacked/anchor.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "backed": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@trybacked/core": "workspace:*",
    "@trybacked/discovery": "workspace:*",
    "@trybacked/mcp": "workspace:*",
    "@trybacked/provider-databricks": "workspace:*",
    "@trybacked/registry": "workspace:*",
    "@trybacked/runtime": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "vitest": "^3.0.5"
  }
}
