{
  "name": "@backed/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI local-first: init, model, review, diff, serve",
  "bin": {
    "backed": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@backed/core": "workspace:*",
    "@inquirer/prompts": "^7.3.2",
    "@backed/diff": "workspace:*",
    "@backed/ingest": "workspace:*",
    "@backed/mcp": "workspace:*",
    "@backed/profile": "workspace:*",
    "@backed/runner": "workspace:*",
    "@backed/semantic": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.85",
    "vitest": "^3.0.5"
  }
}
