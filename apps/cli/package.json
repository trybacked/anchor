{
  "name": "@backed/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anchor CLI: init, inspect, discover, review, publish, diff, validate, serve",
  "bin": {
    "backed": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@trybacked/core": "workspace:*",
    "@inquirer/prompts": "^7.3.2",
    "@backed/diff": "workspace:*",
    "@backed/discovery": "workspace:*",
    "@backed/mcp": "workspace:*",
    "@backed/provider-databricks": "workspace:*",
    "@backed/registry": "workspace:*",
    "@backed/runtime": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "vitest": "^3.0.5"
  }
}
