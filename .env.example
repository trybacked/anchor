# Anchor

# Vercel AI Gateway: https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Review: ask human confirmation when confidence is below this (0–1). Default: 0.95
# REVIEW_CONFIDENCE_THRESHOLD=0.95

# OCR for scanned PDFs (default: on). Requires Poppler (`pdftoppm`) on PATH.
# macOS: brew install poppler
# Set to 1/true/yes to skip OCR entirely.
# BACKED_SKIP_OCR=0
# BACKED_OCR_LANG=ita
# BACKED_OCR_MAX_PAGES=30
# BACKED_OCR_DPI=150

# Language model for all semantic bursts (classification, ontology, document extraction)
# SEMANTIC_MODEL=anthropic/claude-sonnet-4.5
# Embeddings for document semantic search (separate from chat model)
# SEMANTIC_EMBEDDING_MODEL=openai/text-embedding-3-small
# Large folders (many PDF tables): raise timeout and batch column classification
# SEMANTIC_REQUEST_TIMEOUT_MS=600000
# SEMANTIC_CLASSIFICATION_BATCH_SIZE=12