# Anchor

# Databricks SQL warehouse — required for inspect, discover, and query_objects
BACKED_DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
BACKED_DATABRICKS_TOKEN=dapixxxxxxxx
BACKED_DATABRICKS_WAREHOUSE_ID=xxxxxxxx
# Restrict discovery to one catalog/schema (optional)
# BACKED_DATABRICKS_CATALOG=main
# BACKED_DATABRICKS_SCHEMA=sales

# Review: ask human confirmation when confidence is below this (0–1). Default: 0.95
# BACKED_REVIEW_CONFIDENCE_THRESHOLD=0.95

# Reviewer identity recorded in review and audit artifacts. Default: OS user
# BACKED_REVIEWER=
