# Local Anchor workspace
# Gateway and control plane live in deploy/env/local.compose.env.example.

BACKED_ENGINE=files
BACKED_S3_BUCKET=backed-v1
BACKED_S3_REGION=eu-north-1

# Optional document folder (default: ./sources)
# BACKED_FILES_ROOT=./sources

# Semantic ask and ontology extract
AI_GATEWAY_API_KEY=
SEMANTIC_MODEL=openai/gpt-4o-mini

# Only when starting the API from this file
# ANCHOR_API_TOKEN=
# ANCHOR_API_PORT=8787
