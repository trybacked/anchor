# Local Anchor workspace (repo root or tenant folder).
# The CLI walks up from cwd and merges every `.env` found — put shared keys here when the tenant dir has no `.env`.
# Gateway and control plane live in deploy/env/local.compose.env.example.

BACKED_ENGINE=files
BACKED_S3_BUCKET=backed-v1
BACKED_S3_REGION=eu-north-1

# Optional document folder (default: ./sources)
# BACKED_FILES_ROOT=./sources

# Foundry materialize + MCP query_objects (local DuckDB warehouse)
# DuckDB file name must match catalog (e.g. .backed/backed_military.duckdb)
# BACKED_DUCKDB_PATH=.backed/backed_military.duckdb
# BACKED_CATALOG=backed_military

# Required for anchor run, induce, and extract (AI-only pipeline)
AI_GATEWAY_API_KEY=
SEMANTIC_MODEL=openai/gpt-4o-mini
# ONTOLOGY_EXTRACT_MODEL=
# ONTOLOGY_EXTRACT_FALLBACK_MODEL=

# Optional Docling sidecar for PDF/Office parsing
# DOCLING_URL=http://127.0.0.1:5001

# Only when starting the API from this file
# ANCHOR_API_TOKEN=
# ANCHOR_API_PORT=8787
