# Anchor

# Databricks SQL warehouse — required for pull, sync, and query_objects
BACKED_DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
BACKED_DATABRICKS_TOKEN=dapixxxxxxxx
BACKED_DATABRICKS_WAREHOUSE_ID=xxxxxxxx
# Tenant catalog (e.g. backed, backed_gerace)
BACKED_DATABRICKS_CATALOG=backed_gerace
# Optional schema filter for pull
# BACKED_DATABRICKS_SCHEMA=anac
# Documents schema (default docs)
BACKED_DOCUMENTS_SCHEMA=docs
# Optional Databricks vector search index name for hybrid chunk search
# BACKED_VECTOR_SEARCH_INDEX=backed_gerace_docs_document_elements

# Anchor API (one process per tenant)
ANCHOR_API_PORT=8787
ANCHOR_API_TOKEN=change-me
# ANCHOR_WORKSPACE_ROOT=/path/to/ontology/gerace

# Semantic chat (optional — enables POST /v1/chat/ask)
# SEMANTIC_CHAT_LLM_URL=https://api.openai.com/v1/chat/completions
# SEMANTIC_CHAT_LLM_KEY=sk-...
# SEMANTIC_CHAT_LLM_MODEL=gpt-4o-mini
