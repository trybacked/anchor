# Anchor

# Databricks SQL warehouse — required for pull, sync, and query_objects
BACKED_DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
BACKED_DATABRICKS_TOKEN=dapixxxxxxxx
BACKED_DATABRICKS_WAREHOUSE_ID=xxxxxxxx
# Tenant catalog (e.g. backed, backed_gerace)
BACKED_DATABRICKS_CATALOG=backed_gerace
# Optional schema filter for pull
# BACKED_DATABRICKS_SCHEMA=anac
# Documents schema (default docs)
BACKED_DOCUMENTS_SCHEMA=docs
# Optional Databricks vector search index name for hybrid chunk search
# BACKED_VECTOR_SEARCH_INDEX=backed_gerace_docs_document_elements

# Anchor API (one process per tenant)
ANCHOR_API_PORT=8787
# HOST=0.0.0.0   # containers / production bind
ANCHOR_API_TOKEN=change-me
# ANCHOR_WORKSPACE_ROOT=/path/to/ontology/gerace
# ANCHOR_AUDIT_LOG_PATH=/var/log/anchor/audit.jsonl
# ANCHOR_AUDIT_LOG_STDERR=1

# Semantic chat (optional — POST /v1/chat/ask via Vercel AI SDK + AI Gateway)
# One key for all models: https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=
# SEMANTIC_CHAT_MODEL=openai/gpt-4o-mini
# SEMANTIC_MODEL=openai/gpt-4o-mini   # alias used by smoke script / local .env

# Gateway (platform entry — login + /t/{tenant}/v1/*)
# GATEWAY_PORT=8790
# GATEWAY_SESSION_SECRET=   # min 32 chars
# GATEWAY_TENANTS_REGISTRY=/path/to/tenants.yaml
# GATEWAY_USERS_FILE=/path/to/users.yaml
# GATEWAY_PLATFORM_UPSTREAM=http://127.0.0.1:8787
# GATEWAY_PLATFORM_TOKEN=   # same as ANCHOR_API_TOKEN on platform-api
# GATEWAY_DEFAULT_TENANT=gerace   # optional alias for /v1/*
