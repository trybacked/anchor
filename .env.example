# Anchor

# Vercel AI Gateway: https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Review: ask human confirmation when confidence is below this (0–1). Default: 0.95
# REVIEW_CONFIDENCE_THRESHOLD=0.95

# OCR for scanned PDFs (default: on). Requires Poppler (`pdftoppm`) on PATH.
# macOS: brew install poppler
# Set to 1/true/yes to skip OCR entirely.
# BACKED_SKIP_OCR=0
# BACKED_OCR_LANG=ita
# BACKED_OCR_MAX_PAGES=30
# BACKED_OCR_DPI=150

# Language model for all semantic bursts (classification, ontology, document extraction)
# SEMANTIC_MODEL=zai/glm-5.3-flash
# Embeddings for document semantic search (separate from chat model)
# SEMANTIC_EMBEDDING_MODEL=openai/text-embedding-3-small
# Large folders (many PDF tables): raise timeout and batch column classification
# SEMANTIC_REQUEST_TIMEOUT_MS=600000
# SEMANTIC_CLASSIFICATION_BATCH_SIZE=12

# Opt-in MCP usage telemetry (requires backed login). Default: off — serve is fully local.
# BACKED_TELEMETRY=1

# Auth endpoint used by `backed login`. Default: https://api.backed.app
# Point this at a local auth-api (see apps/auth-api) when developing.
# BACKED_API_URL=http://127.0.0.1:8787
# Override where the CLI stores credentials. Default: $XDG_CONFIG_HOME/backed/credentials.json
# BACKED_CREDENTIALS_PATH=

# Databricks SQL warehouse (for `backed inspect --databricks` / `backed discover --databricks`)
# BACKED_DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
# BACKED_DATABRICKS_TOKEN=dapixxxxxxxx
# BACKED_DATABRICKS_WAREHOUSE_ID=xxxxxxxx
# BACKED_DATABRICKS_CATALOG=main
# BACKED_DATABRICKS_SCHEMA=sales