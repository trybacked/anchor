{
  "tenant": "gerace",
  "baselineNotes": "Document archive on backed_gerace.docs.* (≈10 indexed PDFs in contratti/ when last loaded). COV-AP_IT entities on *_profiles tables.",
  "cases": [
    {
      "id": "count-documents",
      "question": "How many documents are in the tenant archive?",
      "expect": {
        "objectId": "document",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1,
        "minProvenanceRows": 1
      }
    },
    {
      "id": "rows-documents-sample",
      "question": "Show at most 5 documents with filename.",
      "expect": {
        "objectId": "document",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5,
        "minProvenanceRows": 1
      }
    },
    {
      "id": "count-document-elements",
      "question": "How many document elements are indexed?",
      "expect": {
        "objectId": "document_element",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1
      }
    },
    {
      "id": "count-organizations",
      "question": "How many organizations are in the ontology?",
      "expect": {
        "objectId": "organization",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1
      }
    },
    {
      "id": "count-public-organizations",
      "question": "How many public organizations are there?",
      "expect": {
        "objectId": "public_organization",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1
      }
    },
    {
      "id": "count-private-organizations",
      "question": "How many private organizations are there?",
      "expect": {
        "objectId": "private_organization",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1
      }
    },
    {
      "id": "count-support-units",
      "question": "How many support units are there?",
      "expect": {
        "objectId": "support_unit",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1
      }
    },
    {
      "id": "count-persons",
      "question": "How many persons are in the ontology?",
      "expect": {
        "objectId": "person",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1
      }
    },
    {
      "id": "rows-organizations-sample",
      "question": "List at most 5 organizations with their name.",
      "expect": {
        "objectId": "organization",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5
      }
    },
    {
      "id": "rows-persons-sample",
      "question": "List at most 5 persons with their name.",
      "expect": {
        "objectId": "person",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5
      }
    },
    {
      "id": "rows-affiliations-sample",
      "question": "List at most 5 person organization affiliations with the affiliation id.",
      "expect": {
        "objectId": "person_organization_affiliation",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5,
        "minProvenanceRows": 1
      }
    },
    {
      "id": "groupby-documents-folder",
      "question": "How many documents are there per folder?",
      "expect": {
        "objectId": "document",
        "mode": "rows",
        "maxAttempts": 2,
        "groupByIncludes": ["folder"],
        "aggregationsMin": 1
      }
    },
    {
      "id": "groupby-elements-type",
      "question": "How many document elements are there per element type?",
      "expect": {
        "objectId": "document_element",
        "mode": "rows",
        "maxAttempts": 2,
        "groupByIncludes": ["element_type"],
        "aggregationsMin": 1
      }
    },
    {
      "id": "avg-page-count",
      "question": "What is the average page count of the documents?",
      "expect": {
        "objectId": "document",
        "maxAttempts": 2,
        "aggregationsMin": 1
      }
    },
    {
      "id": "max-page-number",
      "question": "What is the maximum page number across document elements?",
      "expect": {
        "objectId": "document_element",
        "mode": "rows",
        "maxAttempts": 2,
        "aggregationsMin": 1
      }
    },
    {
      "id": "rows-documents-by-size",
      "question": "Show the 5 largest documents by file size.",
      "expect": {
        "objectId": "document",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5,
        "orderBy": "file_size",
        "orderDirection": "desc"
      }
    },
    {
      "id": "rows-elements-with-document",
      "question": "Show at most 5 document elements together with the filename of their document.",
      "expect": {
        "objectId": "document_element",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5
      }
    },
    {
      "id": "filter-documents-by-pages",
      "optional": true,
      "question": "How many documents have more than 1 page?",
      "expect": {
        "objectId": "document",
        "mode": "count",
        "maxAttempts": 2,
        "filtersInclude": [{ "propertyId": "page_count", "op": "gt", "value": 1 }]
      }
    },
    {
      "id": "reject-unknown-property",
      "optional": true,
      "retries": 0,
      "question": "How many documents have crm_customer_id populated?",
      "expect": {
        "shouldFail": true,
        "failType": "SemanticPlanValidationError"
      }
    },
    {
      "id": "unknown-object-honest-answer",
      "retries": 1,
      "question": "How many invoices are in the tenant archive?",
      "expect": {
        "objectId": "document",
        "maxAttempts": 2,
        "maxRowCount": 50,
        "minProvenanceRows": 1
      }
    }
  ]
}