{
  "tenant": "gerace",
  "baselineNotes": "Document archive on backed_gerace.docs.* (≈10 indexed PDFs in contratti/ when last loaded).",
  "cases": [
    {
      "id": "count-documents",
      "question": "How many documents are in the tenant archive?",
      "expect": {
        "objectId": "document",
        "mode": "count",
        "maxAttempts": 2,
        "countMin": 1,
        "minProvenanceRows": 1
      }
    },
    {
      "id": "rows-documents-sample",
      "question": "Show at most 5 documents with filename.",
      "expect": {
        "objectId": "document",
        "mode": "rows",
        "maxAttempts": 2,
        "maxRowCount": 5,
        "minProvenanceRows": 1
      }
    },
    {
      "id": "reject-unknown-property",
      "optional": true,
      "question": "How many documents have crm_customer_id populated?",
      "expect": {
        "shouldFail": true,
        "failType": "SemanticPlanValidationError"
      }
    }
  ]
}
